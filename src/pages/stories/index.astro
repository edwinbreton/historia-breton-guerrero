---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allStories = await getCollection('stories');

const sorted = allStories.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const branchLabel: Record<string, string> = {
  breton:   'Familia Bretón',
  guerrero: 'Familia Guerrero',
  both:     'Ambas familias',
};
---

<Layout title="Historias">
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1>Historias</h1>
        <p class="page-header__count">
          {allStories.length} {allStories.length === 1 ? 'historia' : 'historias'}
        </p>
      </header>

      <!-- Filter chips -->
      <div class="filters" role="tablist" aria-label="Filtrar por familia">
        <button class="chip chip-neutral active" data-filter="all" role="tab" aria-selected="true">Todas</button>
        <button class="chip chip-breton"         data-filter="breton"   role="tab" aria-selected="false">Familia Bretón</button>
        <button class="chip chip-guerrero"       data-filter="guerrero" role="tab" aria-selected="false">Familia Guerrero</button>
        <button class="chip chip-neutral"        data-filter="both"     role="tab" aria-selected="false">Ambas familias</button>
      </div>

      {allStories.length === 0 ? (
        <div class="empty-state">
          <p>No hay historias registradas todavía.</p>
        </div>
      ) : (
        <div class="stories-list">
          {sorted.map(story => (
            <a
              href={`/stories/${story.id}`}
              class="story-card"
              data-branch={story.data.branch}
            >
              <div class:list={['story-card__band', `band-${story.data.branch}`]} aria-hidden="true"></div>
              <div class="story-card__body">
                {story.data.featuredImage && (
                  <div class="story-card__image">
                    <img src={story.data.featuredImage} alt={story.data.title} />
                  </div>
                )}
                <div class="story-card__content">
                  <div class="story-card__meta">
                    <span class:list={['story-card__branch', `branch-${story.data.branch === 'both' ? 'muted' : story.data.branch}`]}>
                      {branchLabel[story.data.branch]}
                    </span>
                    <span class="story-card__date">
                      {new Date(story.data.date).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', timeZone: 'UTC' })}
                    </span>
                  </div>
                  <h2 class="story-card__title">{story.data.title}</h2>
                  {story.data.author && (
                    <p class="story-card__author">Por {story.data.author}</p>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards   = document.querySelectorAll<HTMLElement>('[data-branch]');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      buttons.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      cards.forEach(card => {
        const show = filter === 'all' || card.dataset.branch === filter;
        (card as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .page {
    padding-block: var(--space-12) var(--space-16);
  }

  .page-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .page-header__count {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }

  .filters {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
    flex-wrap: wrap;
  }

  .chip-neutral.active {
    background: var(--bg);
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }

  /* Stories list */
  .stories-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Story card */
  .story-card {
    display: flex;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    transition: box-shadow 0.15s, transform 0.15s;
  }

  .story-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-1px);
    color: var(--text-primary);
  }

  .story-card__band {
    width: 5px;
    flex-shrink: 0;
  }

  .story-card__body {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-6);
    align-items: center;
    width: 100%;
  }

  .story-card__image {
    flex-shrink: 0;
    width: 120px;
    height: 80px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .story-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-card__content {
    flex: 1;
    min-width: 0;
  }

  .story-card__meta {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .story-card__branch {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .branch-muted { color: var(--text-muted); }

  .story-card__date {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .story-card__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .story-card__author {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Empty state */
  .empty-state {
    padding: var(--space-16);
    text-align: center;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 600px) {
    .story-card__image { display: none; }
    .story-card__title { white-space: normal; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPeople  = await getCollection('people');
const allStories = await getCollection('stories');

// Stats
const photoCount = allPeople.reduce((sum, p) =>
  sum + (p.data.portrait ? 1 : 0) + (p.data.photos?.length ?? 0), 0);

const stats = [
  { label: 'Personas',  value: allPeople.length  || '—' },
  { label: 'Historias', value: allStories.length || '—' },
  { label: 'Fotos',     value: photoCount         || '—' },
];

type Person = (typeof allPeople)[0];

// Branch columns — oldest generation first, up to 4 per branch
function byBirthYear(a: Person, b: Person) {
  const ay = a.data.born ? parseInt(a.data.born) : 9999;
  const by = b.data.born ? parseInt(b.data.born) : 9999;
  return ay - by;
}
const bretonPeople   = allPeople.filter(p => p.data.branch === 'breton'   || p.data.branch === 'both').sort(byBirthYear).slice(0, 4);
const guerreroPeople = allPeople.filter(p => p.data.branch === 'guerrero' || p.data.branch === 'both').sort(byBirthYear).slice(0, 4);

// Meeting couples — find Bretón people married to Guerrero people
const byId = new Map(allPeople.map(p => [p.id, p]));
const meetingCouples: Array<{ breton: Person; guerrero: Person }> = [];
for (const p of allPeople) {
  if (meetingCouples.length >= 2) break;
  if (p.data.branch !== 'breton') continue;
  for (const sid of (p.data.spouses ?? [])) {
    const spouse = byId.get(sid);
    if (spouse?.data.branch === 'guerrero') {
      meetingCouples.push({ breton: p, guerrero: spouse });
      break;
    }
  }
}

// Recently added — most recent stories first, then fill with people
const sortedStories = [...allStories].sort((a, b) => b.data.date.localeCompare(a.data.date));
const recentItems: Array<{ type: 'story' | 'person'; id: string; title: string; subtitle: string; href: string; branch: string; portrait?: string }> = [
  ...sortedStories.slice(0, 3).map(s => ({
    type: 'story' as const,
    id: s.id,
    title: s.data.title,
    subtitle: s.data.date,
    href: `/stories/${s.id}`,
    branch: s.data.branch,
    portrait: s.data.featuredImage,
  })),
  ...allPeople.slice(-3).reverse().map(p => ({
    type: 'person' as const,
    id: p.id,
    title: p.data.name,
    subtitle: p.data.born ? p.data.born.slice(0, 4) : '',
    href: `/people/${p.id}`,
    branch: p.data.branch,
    portrait: p.data.portrait,
  })),
].slice(0, 6);
---

<Layout title="Inicio">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Una historia familiar</p>
      <h1 class="hero__title">
        <span class="hero__name-breton">Bretón</span>
        <span class="hero__amp">&amp;</span>
        <span class="hero__name-guerrero">Guerrero</span>
      </h1>
      <p class="hero__tagline">
        Dos familias, una historia compartida.
      </p>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="stats-bar" aria-label="Estadísticas">
    <div class="container stats-bar__inner">
      {stats.map(stat => (
        <div class="stats-bar__item">
          <span class="stats-bar__value">{stat.value}</span>
          <span class="stats-bar__label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Two-column branch section -->
  <section class="branches" aria-label="Las familias">
    <div class="container branches__inner">
      <!-- Bretón -->
      <div class="branch-col branch-col--breton">
        <div class="branch-col__header">
          <h2 class="branch-col__title">Familia Bretón</h2>
          <a href="/people?branch=breton" class="branch-col__link">Ver todos →</a>
        </div>
        <div class="branch-col__cards">
          {bretonPeople.length > 0 ? bretonPeople.map(p => (
            <a href={`/people/${p.id}`} class="home-person-card">
              <div class="home-person-card__avatar home-person-card__avatar--breton">
                {p.data.portrait && <img src={p.data.portrait} alt={p.data.name} />}
              </div>
              <div class="home-person-card__info">
                <span class="home-person-card__name">{p.data.name}</span>
                {p.data.born && <span class="home-person-card__year">{p.data.born.slice(0,4)}</span>}
              </div>
            </a>
          )) : (
            <div class="branch-empty"><p>Próximamente.</p></div>
          )}
        </div>
      </div>

      <div class="branches__divider" aria-hidden="true"></div>

      <!-- Guerrero -->
      <div class="branch-col branch-col--guerrero">
        <div class="branch-col__header">
          <h2 class="branch-col__title">Familia Guerrero</h2>
          <a href="/people?branch=guerrero" class="branch-col__link">Ver todos →</a>
        </div>
        <div class="branch-col__cards">
          {guerreroPeople.length > 0 ? guerreroPeople.map(p => (
            <a href={`/people/${p.id}`} class="home-person-card">
              <div class="home-person-card__avatar home-person-card__avatar--guerrero">
                {p.data.portrait && <img src={p.data.portrait} alt={p.data.name} />}
              </div>
              <div class="home-person-card__info">
                <span class="home-person-card__name">{p.data.name}</span>
                {p.data.born && <span class="home-person-card__year">{p.data.born.slice(0,4)}</span>}
              </div>
            </a>
          )) : (
            <div class="branch-empty"><p>Próximamente.</p></div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Where the families meet -->
  <section class="meeting" aria-labelledby="meeting-title">
    <div class="container">
      <h2 id="meeting-title" class="meeting__title">Donde las familias se unen</h2>
      <p class="meeting__subtitle">
        Algo poco común: dos hermanos Bretón se casaron con dos hermanos Guerrero,
        uniendo a las familias dos veces.
      </p>
      <div class="meeting__couples">
        {meetingCouples.length > 0 ? meetingCouples.map((couple, i) => (
          <>
            {i > 0 && <div class="meeting__and" aria-hidden="true">y</div>}
            <div class="meeting__couple">
              <a href={`/people/${couple.breton.id}`} class="meeting__person">
                <div class="meeting__avatar meeting__avatar--breton">
                  {couple.breton.data.portrait && <img src={couple.breton.data.portrait} alt={couple.breton.data.name} />}
                </div>
                <p class="meeting__name">{couple.breton.data.name}</p>
                <p class="meeting__family branch-breton">Bretón</p>
              </a>
              <div class="meeting__heart" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="5" />
                </svg>
              </div>
              <a href={`/people/${couple.guerrero.id}`} class="meeting__person">
                <div class="meeting__avatar meeting__avatar--guerrero">
                  {couple.guerrero.data.portrait && <img src={couple.guerrero.data.portrait} alt={couple.guerrero.data.name} />}
                </div>
                <p class="meeting__name">{couple.guerrero.data.name}</p>
                <p class="meeting__family branch-guerrero">Guerrero</p>
              </a>
            </div>
          </>
        )) : (
          <>
            <div class="meeting__couple">
              <div class="meeting__person">
                <div class="meeting__avatar meeting__avatar--breton"></div>
                <p class="meeting__name">—</p>
                <p class="meeting__family branch-breton">Bretón</p>
              </div>
              <div class="meeting__heart" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="5" />
                </svg>
              </div>
              <div class="meeting__person">
                <div class="meeting__avatar meeting__avatar--guerrero"></div>
                <p class="meeting__name">—</p>
                <p class="meeting__family branch-guerrero">Guerrero</p>
              </div>
            </div>
            <div class="meeting__and" aria-hidden="true">y</div>
            <div class="meeting__couple">
              <div class="meeting__person">
                <div class="meeting__avatar meeting__avatar--breton"></div>
                <p class="meeting__name">—</p>
                <p class="meeting__family branch-breton">Bretón</p>
              </div>
              <div class="meeting__heart" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="9" />
                  <circle cx="12" cy="12" r="5" />
                </svg>
              </div>
              <div class="meeting__person">
                <div class="meeting__avatar meeting__avatar--guerrero"></div>
                <p class="meeting__name">—</p>
                <p class="meeting__family branch-guerrero">Guerrero</p>
              </div>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Recently added -->
  <section class="recent" aria-labelledby="recent-title">
    <div class="container">
      <h2 id="recent-title" class="recent__title">Agregado recientemente</h2>
      {recentItems.length > 0 ? (
        <div class="recent__grid">
          {recentItems.map(item => (
            <a href={item.href} class={`recent-card recent-card--${item.branch}`}>
              <div class={`recent-card__thumb recent-card__thumb--${item.branch}`}>
                {item.portrait && <img src={item.portrait} alt={item.title} />}
                {item.type === 'story' && !item.portrait && <span class="recent-card__type-icon">📖</span>}
              </div>
              <div class="recent-card__body">
                <span class={`recent-card__type branch-${item.branch}`}>
                  {item.type === 'story' ? 'Historia' : 'Persona'}
                </span>
                <p class="recent-card__title">{item.title}</p>
                {item.subtitle && <p class="recent-card__sub">{item.subtitle}</p>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="recent__empty">
          <p>El contenido aparecerá aquí próximamente.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-16) var(--space-12);
    text-align: center;
  }

  .hero__eyebrow {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    gap: 0.3em;
    justify-content: center;
    align-items: baseline;
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .hero__name-breton   { color: var(--breton); }
  .hero__amp           { color: var(--text-muted); font-weight: 400; }
  .hero__name-guerrero { color: var(--guerrero); }

  .hero__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Stats bar */
  .stats-bar {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-6);
  }

  .stats-bar__inner {
    display: flex;
    justify-content: center;
    gap: var(--space-12);
    flex-wrap: wrap;
  }

  .stats-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .stats-bar__value {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1;
  }

  .stats-bar__label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* Branch columns */
  .branches {
    padding-block: var(--space-16);
  }

  .branches__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .branches__divider {
    width: 1px;
    background: var(--border);
    align-self: stretch;
  }

  .branch-col__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid;
  }

  .branch-col--breton  .branch-col__header { border-color: var(--breton); }
  .branch-col--guerrero .branch-col__header { border-color: var(--guerrero); }

  .branch-col__title {
    font-size: 1.25rem;
  }

  .branch-col--breton  .branch-col__title { color: var(--breton); }
  .branch-col--guerrero .branch-col__title { color: var(--guerrero); }

  .branch-col__link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .branch-col__link:hover { color: var(--text-primary); }

  .branch-empty {
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    color: var(--text-muted);
  }

  .branch-empty p { margin-bottom: 0; }

  /* Meeting section */
  .meeting {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-16);
    text-align: center;
  }

  .meeting__title {
    margin-bottom: var(--space-3);
  }

  .meeting__subtitle {
    color: var(--text-secondary);
    font-style: italic;
    max-width: 480px;
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .meeting__couples {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .meeting__couple {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .meeting__and {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .meeting__person {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .meeting__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 3px solid;
  }

  .meeting__avatar--breton {
    background: var(--breton-light);
    border-color: var(--breton);
  }

  .meeting__avatar--guerrero {
    background: var(--guerrero-light);
    border-color: var(--guerrero);
  }

  .meeting__name {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .meeting__family {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .meeting__heart {
    color: var(--text-muted);
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  /* Recent section */
  .recent {
    padding-block: var(--space-16);
  }

  .recent__title {
    margin-bottom: var(--space-8);
  }

  .recent__empty {
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-12);
    text-align: center;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  /* Home person cards (branch columns) */
  .branch-col__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .home-person-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .home-person-card:hover {
    border-color: var(--breton);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  .branch-col--guerrero .home-person-card:hover {
    border-color: var(--guerrero);
  }

  .home-person-card__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    border: 2px solid;
  }
  .home-person-card__avatar--breton   { border-color: var(--breton);   background: var(--breton-light); }
  .home-person-card__avatar--guerrero { border-color: var(--guerrero); background: var(--guerrero-light); }
  .home-person-card__avatar img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .home-person-card__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .home-person-card__name {
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .home-person-card__year {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Meeting section — clickable person cards */
  .meeting__person {
    text-decoration: none;
    color: inherit;
  }
  .meeting__avatar {
    overflow: hidden;
  }
  .meeting__avatar img {
    width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
  }

  /* Recently added grid */
  .recent__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .recent-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text-primary);
    background: var(--surface);
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .recent-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }
  .recent-card--breton:hover   { border-color: var(--breton); }
  .recent-card--guerrero:hover { border-color: var(--guerrero); }
  .recent-card--both:hover     { border-color: var(--breton); }

  .recent-card__thumb {
    width: 100%;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }
  .recent-card__thumb--breton   { background: var(--breton-light); }
  .recent-card__thumb--guerrero { background: var(--guerrero-light); }
  .recent-card__thumb--both     { background: linear-gradient(135deg, var(--breton-light) 50%, var(--guerrero-light) 50%); }
  .recent-card__thumb img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .recent-card__body {
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .recent-card__type {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
  }
  .recent-card__title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .recent-card__sub {
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .branches__inner {
      grid-template-columns: 1fr;
    }

    .branches__divider {
      width: 100%;
      height: 1px;
      align-self: auto;
    }

    .stats-bar__inner {
      gap: var(--space-8);
    }
  }
</style>

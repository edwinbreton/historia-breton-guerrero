---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ADMIN_COOKIE, decodeSession } from '../../../lib/admin-auth';
import { savePerson, saveUploadedFile } from '../../../lib/content-writer';
import { getCollection } from 'astro:content';

const session = Astro.cookies.get(ADMIN_COOKIE);
const user    = session ? decodeSession(session.value) : null;

let errors: string[] = [];
let saved = false;

const allPeople = await getCollection('people');
const peopleOptions = allPeople
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'es'))
  .map(p => ({ id: p.id, name: p.data.name }));

if (Astro.request.method === 'POST') {
  const form   = await Astro.request.formData();
  const fields: Record<string, string> = {};
  form.forEach((v, k) => { if (typeof v === 'string') fields[k] = v; });

  if (!fields.name) errors.push('El nombre es requerido.');
  if (!fields.branch) errors.push('La familia es requerida.');
  if (!fields.generation) errors.push('La generación es requerida.');

  if (errors.length === 0) {
    // Handle portrait upload
    let portraitPath: string | null = null;
    const portraitFile = form.get('portrait') as File | null;
    if (portraitFile && portraitFile.size > 0) {
      portraitPath = await saveUploadedFile(portraitFile, 'people');
    }

    const slug = savePerson({
      ...fields,
      portrait: portraitPath,
      deceased: fields.deceased === '1',
      died:     fields.deceased === '1' ? (fields.died || null) : null,
      parents:  fields.parents  ? fields.parents.split(',').filter(Boolean)  : [],
      children: fields.children ? fields.children.split(',').filter(Boolean) : [],
      spouses:  fields.spouses  ? fields.spouses.split(',').filter(Boolean)  : [],
    }, user?.username ?? 'unknown');

    return Astro.redirect(`/admin/personas/${slug}/editar?saved=1`);
  }
}
---

<AdminLayout title="Nueva persona">
  <div class="form-page">
    <div class="form-header">
      <a href="/admin" class="back-link">← Dashboard</a>
      <h1>Agregar persona</h1>
    </div>

    {errors.length > 0 && (
      <div class="error-banner" role="alert">
        {errors.map(e => <p>{e}</p>)}
      </div>
    )}

    <form method="POST" enctype="multipart/form-data" class="person-form">
      <div class="form-section">
        <h2 class="form-section__title">Información básica</h2>
        <div class="form-grid">
          <div class="field field--full">
            <label for="name">Nombre completo *</label>
            <input type="text" id="name" name="name" required placeholder="Ej. María Guerrero López" />
          </div>
          <div class="field">
            <label for="branch">Familia *</label>
            <select id="branch" name="branch" required>
              <option value="">— Seleccionar —</option>
              <option value="breton">Bretón</option>
              <option value="guerrero">Guerrero</option>
              <option value="both">Ambas familias</option>
            </select>
          </div>
          <div class="field">
            <label for="generation">Generación *</label>
            <select id="generation" name="generation" required>
              <option value="">— Seleccionar —</option>
              <option value="1">Bisabuelos</option>
              <option value="2">Abuelos</option>
              <option value="3">Padres</option>
              <option value="4">Hijos</option>
              <option value="5">Nietos</option>
            </select>
          </div>
          <div class="field">
            <label for="born">Fecha de nacimiento</label>
            <input type="date" id="born" name="born" />
          </div>
          <div class="field">
            <label class="checkbox-label">
              <input type="checkbox" id="deceased" name="deceased" value="1" />
              Fallecido
            </label>
            <div id="died-wrap" class="died-wrap hidden">
              <label for="died" class="sub-label">Fecha de fallecimiento <span class="optional">(opcional)</span></label>
              <input type="date" id="died" name="died" />
            </div>
          </div>
          <div class="field">
            <label for="birthplace">Lugar de nacimiento</label>
            <input type="text" id="birthplace" name="birthplace" placeholder="Ej. Guadalajara, México" />
          </div>
          <div class="field">
            <label for="occupation">Ocupación</label>
            <input type="text" id="occupation" name="occupation" placeholder="Ej. Médico, Maestra..." />
          </div>
          <div class="field field--full">
            <label for="portrait">Foto principal</label>
            <input type="file" id="portrait" name="portrait" accept="image/*" class="file-input" />
            <p class="field-hint">Formatos aceptados: JPG, PNG, WEBP. Se puede cambiar después.</p>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section__title">Relaciones familiares</h2>
        <p class="form-section__hint">Selecciona las personas relacionadas de las listas. Puedes seleccionar varias con Ctrl+clic (o Cmd+clic en Mac).</p>
        <div class="form-grid">
          <div class="field">
            <label for="spouses">Cónyuge(s)</label>
            <select id="spouses-select" multiple class="multi-select">
              {peopleOptions.map(p => <option value={p.id}>{p.name}</option>)}
            </select>
            <input type="hidden" id="spouses" name="spouses" />
          </div>
          <div class="field">
            <label for="parents">Padres</label>
            <select id="parents-select" multiple class="multi-select">
              {peopleOptions.map(p => <option value={p.id}>{p.name}</option>)}
            </select>
            <input type="hidden" id="parents" name="parents" />
          </div>
          <div class="field">
            <label for="children">Hijos</label>
            <select id="children-select" multiple class="multi-select">
              {peopleOptions.map(p => <option value={p.id}>{p.name}</option>)}
            </select>
            <input type="hidden" id="children" name="children" />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section__title">Biografía</h2>
        <div class="field field--full">
          <label for="bio">Texto libre</label>
          <textarea id="bio" name="bio" rows="8" placeholder="Escribe aquí la historia de esta persona..."></textarea>
        </div>
      </div>

      <div class="form-actions">
        <a href="/admin" class="btn-cancel">Cancelar</a>
        <button type="submit" class="btn-save">Guardar persona</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  // Deceased checkbox toggle
  const deceasedBox = document.getElementById('deceased') as HTMLInputElement;
  const diedWrap    = document.getElementById('died-wrap')!;
  deceasedBox.addEventListener('change', () => {
    diedWrap.classList.toggle('hidden', !deceasedBox.checked);
  });

  // Sync multi-selects to hidden inputs as comma-separated values
  ['spouses', 'parents', 'children'].forEach(field => {
    const sel    = document.getElementById(`${field}-select`) as HTMLSelectElement;
    const hidden = document.getElementById(field) as HTMLInputElement;
    sel.addEventListener('change', () => {
      hidden.value = Array.from(sel.selectedOptions).map(o => o.value).join(',');
    });
  });
</script>

<style>
  .form-page { max-width: 760px; }

  .form-header {
    margin-bottom: var(--space-8);
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  .back-link:hover { color: var(--text-primary); }

  .form-header h1 { font-size: 1.75rem; }

  .error-banner {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: var(--radius);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    color: #b91c1c;
    font-size: 0.9375rem;
  }

  .error-banner p { margin: 0; }

  .success-banner {
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: var(--radius);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    color: #15803d;
    font-size: 0.9375rem;
  }

  /* Form sections */
  .form-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .form-section__title {
    font-size: 1rem;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .form-section__hint {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field--full { grid-column: 1 / -1; }

  .field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .field input,
  .field select,
  .field textarea {
    padding: var(--space-3) var(--space-4);
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text-primary);
    transition: border-color 0.15s;
    width: 100%;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--breton);
  }

  .field textarea { resize: vertical; line-height: 1.6; }

  .multi-select { min-height: 120px; }

  .file-input {
    padding: var(--space-2) !important;
    font-size: 0.875rem !important;
    cursor: pointer;
  }

  .field-hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
    padding-top: var(--space-6);
  }

  .checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    padding: 0;
    border: 1.5px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .died-wrap {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .died-wrap.hidden { display: none; }

  .sub-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  /* Actions */
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .btn-cancel {
    padding: var(--space-3) var(--space-6);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: background 0.15s;
  }

  .btn-cancel:hover { background: var(--bg); color: var(--text-primary); }

  .btn-save {
    padding: var(--space-3) var(--space-8);
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: var(--font-sans);
    color: white;
    background: var(--breton);
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .btn-save:hover { opacity: 0.85; }

  @media (max-width: 600px) {
    .form-grid { grid-template-columns: 1fr; }
    .field--full { grid-column: 1; }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPeople = await getCollection('people');

// Sort by generation then name
const sorted = allPeople.sort((a, b) => {
  if (a.data.generation !== b.data.generation) return a.data.generation - b.data.generation;
  return a.data.name.localeCompare(b.data.name, 'es');
});

const breton   = sorted.filter(p => p.data.branch === 'breton');
const guerrero = sorted.filter(p => p.data.branch === 'guerrero');
const both     = sorted.filter(p => p.data.branch === 'both');
---

<Layout title="Personas">
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1>Personas</h1>
        <p class="page-header__count">
          {allPeople.length} {allPeople.length === 1 ? 'persona' : 'personas'}
        </p>
      </header>

      <!-- Filter chips -->
      <div class="filters" role="tablist" aria-label="Filtrar por familia">
        <button class="chip chip-neutral active" data-filter="all" role="tab" aria-selected="true">
          Todos
        </button>
        <button class="chip chip-breton" data-filter="breton" role="tab" aria-selected="false">
          Familia Bretón
        </button>
        <button class="chip chip-guerrero" data-filter="guerrero" role="tab" aria-selected="false">
          Familia Guerrero
        </button>
        <button class="chip chip-neutral" data-filter="both" role="tab" aria-selected="false">
          Ambas familias
        </button>
      </div>

      {allPeople.length === 0 ? (
        <div class="empty-state">
          <p>No hay personas registradas todavía.</p>
        </div>
      ) : (
        <>
          <!-- Bretón section -->
          <section class="branch-section" data-branch="breton" aria-labelledby="breton-heading">
            <h2 id="breton-heading" class="branch-heading branch-heading--breton">
              Familia Bretón
              <span class="branch-heading__count">{breton.length}</span>
            </h2>
            <div class="people-grid">
              {breton.map(person => (
                <a href={`/people/${person.data.slug}`} class="person-card person-card--breton">
                  <div class="person-card__band band-breton" aria-hidden="true"></div>
                  <div class="person-card__body">
                    <div class="person-card__portrait">
                      {person.data.portrait
                        ? <img src={person.data.portrait} alt={person.data.name} />
                        : <div class="person-card__portrait-placeholder person-card__portrait-placeholder--breton"></div>
                      }
                    </div>
                    <div class="person-card__info">
                      <h3 class="person-card__name">{person.data.name}</h3>
                      {person.data.born && (
                        <p class="person-card__dates">
                          {person.data.born.slice(0, 4)}
                          {person.data.died ? ` – ${person.data.died.slice(0, 4)}` : ''}
                        </p>
                      )}
                      {person.data.birthplace && (
                        <p class="person-card__place">{person.data.birthplace}</p>
                      )}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <!-- Guerrero section -->
          <section class="branch-section" data-branch="guerrero" aria-labelledby="guerrero-heading">
            <h2 id="guerrero-heading" class="branch-heading branch-heading--guerrero">
              Familia Guerrero
              <span class="branch-heading__count">{guerrero.length}</span>
            </h2>
            <div class="people-grid">
              {guerrero.map(person => (
                <a href={`/people/${person.data.slug}`} class="person-card person-card--guerrero">
                  <div class="person-card__band band-guerrero" aria-hidden="true"></div>
                  <div class="person-card__body">
                    <div class="person-card__portrait">
                      {person.data.portrait
                        ? <img src={person.data.portrait} alt={person.data.name} />
                        : <div class="person-card__portrait-placeholder person-card__portrait-placeholder--guerrero"></div>
                      }
                    </div>
                    <div class="person-card__info">
                      <h3 class="person-card__name">{person.data.name}</h3>
                      {person.data.born && (
                        <p class="person-card__dates">
                          {person.data.born.slice(0, 4)}
                          {person.data.died ? ` – ${person.data.died.slice(0, 4)}` : ''}
                        </p>
                      )}
                      {person.data.birthplace && (
                        <p class="person-card__place">{person.data.birthplace}</p>
                      )}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <!-- Both section -->
          {both.length > 0 && (
            <section class="branch-section" data-branch="both" aria-labelledby="both-heading">
              <h2 id="both-heading" class="branch-heading branch-heading--both">
                Ambas familias
                <span class="branch-heading__count">{both.length}</span>
              </h2>
              <div class="people-grid">
                {both.map(person => (
                  <a href={`/people/${person.data.slug}`} class="person-card person-card--both">
                    <div class="person-card__band band-both" aria-hidden="true"></div>
                    <div class="person-card__body">
                      <div class="person-card__portrait">
                        {person.data.portrait
                          ? <img src={person.data.portrait} alt={person.data.name} />
                          : <div class="person-card__portrait-placeholder person-card__portrait-placeholder--both"></div>
                        }
                      </div>
                      <div class="person-card__info">
                        <h3 class="person-card__name">{person.data.name}</h3>
                        {person.data.born && (
                          <p class="person-card__dates">
                            {person.data.born.slice(0, 4)}
                            {person.data.died ? ` – ${person.data.died.slice(0, 4)}` : ''}
                          </p>
                        )}
                        {person.data.birthplace && (
                          <p class="person-card__place">{person.data.birthplace}</p>
                        )}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const sections = document.querySelectorAll<HTMLElement>('[data-branch]');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      buttons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      sections.forEach(section => {
        const show = filter === 'all' || section.dataset.branch === filter;
        section.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .page {
    padding-block: var(--space-12) var(--space-16);
  }

  .page-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .page-header__count {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Filters */
  .filters {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
    flex-wrap: wrap;
  }

  .chip-neutral.active {
    background: var(--bg);
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }

  /* Branch section */
  .branch-section {
    margin-bottom: var(--space-16);
  }

  .branch-heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.25rem;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid;
  }

  .branch-heading--breton   { color: var(--breton);        border-color: var(--breton); }
  .branch-heading--guerrero { color: var(--guerrero);      border-color: var(--guerrero); }
  .branch-heading--both     { color: var(--text-primary);  border-color: var(--shared); }

  .branch-heading__count {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 1px 10px;
  }

  /* People grid */
  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  /* Person card */
  .person-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    transition: box-shadow 0.15s, transform 0.15s;
  }

  .person-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-2px);
    color: var(--text-primary);
  }

  .person-card__band {
    height: 5px;
    flex-shrink: 0;
  }

  .person-card__body {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4);
    align-items: center;
  }

  .person-card__portrait {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
  }

  .person-card__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person-card__portrait-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .person-card__portrait-placeholder--breton   { background: var(--breton-light);   border: 2px solid var(--breton-border); }
  .person-card__portrait-placeholder--guerrero { background: var(--guerrero-light); border: 2px solid var(--guerrero-border); }
  .person-card__portrait-placeholder--both     { background: var(--bg);            border: 2px solid var(--shared); }

  .person-card__name {
    font-size: 1rem;
    margin-bottom: var(--space-1);
  }

  .person-card__dates,
  .person-card__place {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* Empty state */
  .empty-state {
    padding: var(--space-16);
    text-align: center;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 480px) {
    .people-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPeople = await getCollection('people');
const allIds = new Set(allPeople.map(p => p.id));

const data = allPeople.map(p => ({
  id: p.id,
  data: {
    gender:       p.data.gender ?? 'M',
    'first name': p.data.name.split(' ').slice(0, -1).join(' ') || p.data.name,
    'last name':  p.data.name.split(' ').slice(-1)[0] ?? '',
    birthday:     p.data.born?.slice(0, 4) ?? '',
    avatar:       p.data.portrait ?? '',
    branch:       p.data.branch,
  },
  rels: {
    parents:  (p.data.parents  ?? []).filter((id: string) => allIds.has(id)),
    spouses:  (p.data.spouses  ?? []).filter((id: string) => allIds.has(id)),
    children: (p.data.children ?? []).filter((id: string) => allIds.has(id)),
  },
}));
---

<Layout title="Árbol familiar">
  <link rel="stylesheet" href="/fc.css" slot="head" />
  <div class="tree-page">
    <div class="toolbar">
      <span class="toolbar__title">Árbol familiar</span>
      <div class="toolbar__legend">
        <span class="legend-dot legend-dot--breton"></span> Bretón
        <span class="legend-dot legend-dot--guerrero"></span> Guerrero
      </div>
    </div>

    {data.length === 0 ? (
      <div class="tree-empty">
        <p>No hay personas registradas todavía.</p>
      </div>
    ) : (
      <div
        id="FamilyChart"
        data-people={JSON.stringify(data)}
      ></div>
    )}
  </div>
</Layout>

<script>
  import * as f3 from 'family-chart';

  const cont = document.getElementById('FamilyChart') as HTMLElement;
  if (cont) {
    const data = JSON.parse(cont.dataset.people ?? '[]');

    const f3Chart = f3.createChart(cont, data)
      .setTransitionTime(500)
      .setCardXSpacing(250)
      .setCardYSpacing(150);

    f3Chart.setCardHtml()
      .setCardDisplay([["first name", "last name"], ["birthday"]]);

    f3Chart.updateTree({ initial: true });
  }
</script>

<style>
  .tree-page {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 4rem);
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .toolbar__title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-right: auto;
  }

  .toolbar__legend {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 4px;
    vertical-align: middle;
  }

  .legend-dot--breton   { background: var(--breton); }
  .legend-dot--guerrero { background: var(--guerrero); }

  /* Match the official example — fixed height container */
  #FamilyChart {
    width: 100%;
    flex: 1;
    background-color: #F7F6F3;
    color: #2A2A24;
  }

  .tree-empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }
</style>

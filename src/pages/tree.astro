---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPeople = await getCollection('people');
const allIds = new Set(allPeople.map(p => p.id));

const data = allPeople.map(p => {
  // Split Hispanic names: first 1-2 words = given names, last 2 = family surnames
  const parts = p.data.name.trim().split(/\s+/);
  const splitAt = parts.length >= 4 ? 2 : 1;
  const givenNames  = parts.slice(0, splitAt).join(' ');
  const familyNames = parts.slice(splitAt).join(' ');

  return {
    id: p.id,
    data: {
      gender:       p.data.gender ?? 'M',
      'first name': givenNames,
      'last name':  familyNames,
      birthday:     p.data.born?.slice(0, 4) ?? '',
      avatar:       p.data.portrait ?? '',
      branch:       p.data.branch,
    },
    rels: {
      parents:  (p.data.parents  ?? []).filter((id: string) => allIds.has(id)),
      spouses:  (p.data.spouses  ?? []).filter((id: string) => allIds.has(id)),
      children: (p.data.children ?? []).filter((id: string) => allIds.has(id)),
    },
  };
});
---

<Layout title="Árbol familiar">
  <link rel="stylesheet" href="/fc.css" slot="head" />
  <div class="tree-page">
    <div class="toolbar">
      <span class="toolbar__title">Árbol familiar</span>
      <div class="toolbar__legend">
        <span class="legend-dot legend-dot--breton"></span> Bretón
        <span class="legend-dot legend-dot--guerrero"></span> Guerrero
      </div>
    </div>

    {data.length === 0 ? (
      <div class="tree-empty">
        <p>No hay personas registradas todavía.</p>
      </div>
    ) : (
      <div
        id="FamilyChart"
        class="f3"
        data-people={JSON.stringify(data)}
      ></div>
    )}
  </div>
</Layout>

<script>
  import * as f3 from 'family-chart';

  const cont = document.getElementById('FamilyChart') as HTMLElement;
  if (!cont) throw new Error('FamilyChart container not found');

  const data = JSON.parse(cont.dataset.people ?? '[]');

  // Branch color tokens — kept in sync with global.css design tokens
  const BRANCH_BG: Record<string, string> = {
    breton:   '#E3D9C8',
    guerrero: '#C4D8D5',
    both:     'linear-gradient(135deg, #E3D9C8 50%, #C4D8D5 50%)',
  };
  const BRANCH_ACCENT: Record<string, string> = {
    breton:   '#7A6E5A',
    guerrero: '#5A7270',
    both:     '#7A6E5A',
  };

  const f3Chart = f3.createChart(cont, data)
    .setTransitionTime(500)
    .setCardXSpacing(280)
    .setCardYSpacing(160);

  f3Chart.setCardHtml()
    .setMiniTree(true)
    .setCardInnerHtmlCreator((d: any) => {
      const person = d.data.data as Record<string, string>;

      // Placeholder for unknown / to-add cards
      if (d.data.to_add || d.data.unknown) {
        return `<div class="card-inner card-rect bg-card-placeholder">
          ${d.data.to_add ? '+' : '?'}
        </div>`;
      }

      const name1  = person['first name'] || '';
      const name2  = person['last name']  || '';
      const year   = person['birthday'];
      const img    = person['avatar'];
      const branch = person['branch'] || 'both';
      const id     = d.data.id as string;

      const bg     = BRANCH_BG[branch]     ?? BRANCH_BG.both;
      const accent = BRANCH_ACCENT[branch] ?? BRANCH_ACCENT.breton;

      return `
        <div class="card-inner card-image-rect" style="background:${bg};border-left:3px solid ${accent};">
          ${img
            ? `<img src="${img}" alt="" loading="lazy">`
            : `<div class="card-no-photo"></div>`
          }
          <div class="card-label">
            <div class="card-name1">${name1}</div>
            ${name2 ? `<div class="card-name2">${name2}</div>` : ''}
            ${year  ? `<div class="card-year">${year}</div>`  : ''}
            <a href="/people/${id}" class="card-profile-link" onclick="event.stopPropagation()">Ver perfil →</a>
          </div>
        </div>
      `;
    });

  f3Chart.updateTree({ initial: true });
</script>

<style>
  .tree-page {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 4rem);
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .toolbar__title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-right: auto;
  }

  .toolbar__legend {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 4px;
    vertical-align: middle;
  }

  .legend-dot--breton   { background: var(--breton); }
  .legend-dot--guerrero { background: var(--guerrero); }

  #FamilyChart {
    width: 100%;
    flex: 1;
  }

  .tree-empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  /* ── Custom card elements ───────────────────────── */

  /* Photo placeholder when no portrait is set */
  :global(.f3 .card-no-photo) {
    height: 70px;
    width: 70px;
    flex: 0 0 auto;
    margin-right: 10px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.08);
  }

  /* Name lines */
  :global(.f3 .card-name1) {
    font-weight: 600;
    font-size: 0.8rem;
    line-height: 1.3;
  }
  :global(.f3 .card-name2) {
    font-size: 0.75rem;
    line-height: 1.3;
    opacity: 0.7;
  }
  :global(.f3 .card-year) {
    font-size: 0.7rem;
    opacity: 0.55;
    margin-top: 1px;
  }

  /* "Ver perfil" link on each card */
  :global(.f3 .card-profile-link) {
    display: inline-block;
    margin-top: 4px;
    font-size: 0.65rem;
    color: #7A6E5A;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.15s;
  }
  :global(.f3 .card-profile-link:hover) {
    opacity: 1;
    text-decoration: underline;
  }

  /* Placeholder cards (add / unknown) */
  :global(.f3 .bg-card-placeholder) {
    width: 80px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    background: rgba(0, 0, 0, 0.05);
  }
</style>

---
import '../styles/global.css';
import { ADMIN_COOKIE, decodeSession } from '../lib/admin-auth';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.cookies.get(ADMIN_COOKIE);
const user    = session ? decodeSession(session.value) : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Admin · Bretón &amp; Guerrero</title>
  </head>
  <body class="admin-body">
    <header class="admin-nav">
      <div class="admin-nav__inner">
        <a href="/admin" class="admin-nav__logo">
          <span class="admin-nav__logo-breton">Bretón</span>
          <span class="admin-nav__logo-amp">&amp;</span>
          <span class="admin-nav__logo-guerrero">Guerrero</span>
          <span class="admin-nav__badge">Admin</span>
        </a>
        <nav class="admin-nav__links">
          <a href="/" class="admin-nav__link admin-nav__link--muted" target="_blank">Ver sitio ↗</a>
        </nav>
        {user && (
          <div class="admin-nav__user">
            <span class="admin-nav__username">{user.displayName}</span>
            <form method="POST" action="/admin/logout">
              <button type="submit" class="admin-nav__logout">Salir</button>
            </form>
          </div>
        )}
      </div>
    </header>

    <main class="admin-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .admin-body {
    background: #F0EFEC;
    min-height: 100vh;
  }

  .admin-nav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .admin-nav__inner {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: var(--space-6);
    height: 3.5rem;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .admin-nav__logo {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    flex-shrink: 0;
  }

  .admin-nav__logo-breton   { color: var(--breton); }
  .admin-nav__logo-amp      { color: var(--text-muted); }
  .admin-nav__logo-guerrero { color: var(--guerrero); }

  .admin-nav__badge {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--breton-light);
    color: var(--breton);
    border: 1px solid var(--breton-border);
    border-radius: 999px;
    padding: 1px 7px;
    margin-left: var(--space-1);
  }

  .admin-nav__links {
    display: flex;
    gap: var(--space-4);
    flex: 1;
  }

  .admin-nav__link {
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .admin-nav__link:hover { color: var(--text-primary); }
  .admin-nav__link--muted { color: var(--text-muted); font-weight: 400; }

  .admin-nav__user {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .admin-nav__username {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .admin-nav__logout {
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 3px 10px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .admin-nav__logout:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  .admin-main {
    max-width: 1100px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
  }
</style>
